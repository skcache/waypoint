# Waypoint — environment file template.
#
# Copy to `.env` and fill in values as needed:  cp .env.example .env
# `.env` files are git-ignored. NEVER commit real credentials.
#
# The Phase 01 scaffold intentionally starts WITHOUT PayPal or LLM credentials:
# the API health endpoint works with no configuration at all. Features that
# require external services report NOT_CONFIGURED until values are provided —
# nothing is ever simulated silently.

APP_ENV=development
API_PORT=8080
WEB_ORIGIN=http://localhost:3000

# Local development database. These credentials are EXAMPLES ONLY and match
# compose.yaml; they are not secrets and must not be reused elsewhere.
# Host port 5433 avoids clashing with other local Postgres instances.
DATABASE_URL=postgres://waypoint:waypoint@localhost:5433/waypoint?sslmode=disable

# PayPal REST — sandbox only for this project. Production hosts are not
# supported or accepted by the application.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Runtime AI provider (intent draft compilation; V2 uses it for incident
# investigation and repair in later milestones).
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# V2 merchant checkout fixture (apps/api/cmd/merchant). The fixture talks to
# the PayPal Sandbox only and stores its orders in PostgreSQL.
MERCHANT_PORT=8090
# Fault injection for the demo: "none" (default) or "F1" (the seeded
# float-formatting defect that makes the provider reject the checkout).
MERCHANT_FAULT=none
# Where redacted incident artifacts are written (git-ignored path).
MERCHANT_INCIDENT_DIR=docs/incidents

# Demo session signing secret. Generate a fresh random value for any shared
# environment:  openssl rand -hex 32
DEMO_SESSION_SECRET=
